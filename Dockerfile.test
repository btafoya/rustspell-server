# syntax=docker/dockerfile:1

# Test runner image. Compiles and runs the pure-Rust live API tester.

FROM rust:1-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY benches ./benches
COPY openapi.json ./
COPY tests ./tests

ENV RUSTSPELL_TEST_REPORT_DIR=/app/test-reports

ENTRYPOINT ["cargo", "test", "--features", "live-tests", "--test", "live_api_tester"]
